# Variable names for docs/02-system-design.md sec. 10. Placeholders only: never put real values in this file.
# Copy to .env (local dev) and .env.test (integration tests), then fill in real values there.
# Placeholders have no spaces so scripts/check-secrets.mjs recognises them.

# Database (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=<neon-pooled-url>
DIRECT_URL=<neon-direct-url>

# Session (S1)
SESSION_SECRET=<at-least-32-random-characters>

# Demo (S1)
DEMO_MODE=true
DEMO_PASSWORD=<demo-password>

# AI provider (S3): gemini or mock
AI_PROVIDER=mock
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=<primary-model-id>
GEMINI_FALLBACK_MODEL=<fallback-model-id>

# AI bounds (S3)
AI_MAX_CALLS_PER_DAY=200
AI_TIMEOUT_MS=12000
AI_DEADLINE_MS=25000
AI_MAX_ATTEMPTS=3
AI_MAX_REPAIRS=1
AI_MIN_INTERVAL_MS=4000
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=2048

# AI pricing in USD per million tokens (S3)
AI_PRICE_INPUT_PER_MTOK=<usd-per-million-input-tokens>
AI_PRICE_OUTPUT_PER_MTOK=<usd-per-million-output-tokens>

# Moderation (S3-S5)
AUTO_CLEAR_ENABLED=true
AUTO_CLEAR_MIN_CONFIDENCE=0.85
HUMAN_CONFIDENCE_THRESHOLD=0.7
APPEAL_WINDOW_DAYS=14

# Jobs (S2)
JOB_LEASE_MS=120000
JOB_BUDGET_MS=50000
CRON_SECRET=<cron-secret>

# Logging: trace, debug, info, warn, error or fatal
LOG_LEVEL=info

# Tests only. Set to true in .env.test and nowhere else: integration tests refuse to run without it,
# because they empty every table before each test.
TEST_DATABASE=false
