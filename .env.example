# Variable names for docs/02-system-design.md sec. 10. Placeholders only: never put real values in this file.
# Copy to .env (local dev) and .env.test (integration tests), then fill in real values there.
# Placeholders have no spaces so scripts/check-secrets.mjs recognises them.

# Database (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL=<neon-pooled-url>
DIRECT_URL=<neon-direct-url>

# Session (S1)
SESSION_SECRET=<at-least-32-random-characters>

# Demo (S1)
DEMO_MODE=true
DEMO_PASSWORD=<demo-password>

# AI provider (S3): gemini or mock (default mock). The mock needs no key; for live AI set gemini and the key.
AI_PROVIDER=mock
GEMINI_API_KEY=<gemini-api-key>
# Model ids are public configuration, not secrets. An empty fallback turns the fallback model off.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# AI bounds (S3)
AI_MAX_CALLS_PER_DAY=200
AI_TIMEOUT_MS=12000
AI_DEADLINE_MS=25000
AI_MAX_ATTEMPTS=3
AI_MAX_REPAIRS=1
AI_MIN_INTERVAL_MS=4000
AI_MAX_INPUT_TOKENS=6000
AI_MAX_OUTPUT_TOKENS=2048

# AI pricing in USD per million tokens (S3), from Google's published price list for the primary model.
# Required when AI_PROVIDER=gemini; thinking tokens are billed as output.
AI_PRICE_INPUT_PER_MTOK=0.30
AI_PRICE_OUTPUT_PER_MTOK=2.50

# Moderation (S3-S5)
AUTO_CLEAR_ENABLED=true
AUTO_CLEAR_MIN_CONFIDENCE=0.85
HUMAN_CONFIDENCE_THRESHOLD=0.7
APPEAL_WINDOW_DAYS=14

# Jobs (S2)
JOB_LEASE_MS=120000
JOB_BUDGET_MS=50000
# Shared secret for the external cron's GET /api/jobs/tick (x-cron-secret header). Optional: unset or shorter
# than 16 characters turns the tick off; the app still starts.
CRON_SECRET=<cron-secret>

# Logging: trace, debug, info, warn, error or fatal
LOG_LEVEL=info

# Tests only. Set to true in .env.test and nowhere else: integration tests refuse to run without it,
# because they empty every table before each test.
TEST_DATABASE=false
# Playwright only: the URL of a running app to test. Unset, the suite starts one on 127.0.0.1:3000.
# BASE_URL=<app-url>

# Set by the platform, never by hand (listed so every variable the code reads is named here):
# NODE_ENV=<set-by-nextjs>
# VERCEL_GIT_COMMIT_SHA=<set-by-vercel>   the release shown on /status
# BUILD_TIME=<set-by-next-config>         when this release was built, shown on /status
# CI=<set-by-github-actions>              Playwright retries and the HTML report
