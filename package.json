{
  "name": "moderation-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:ascii": "node scripts/check-ascii.mjs",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "check:trace": "node scripts/check-trace.mjs",
    "check:repo": "node scripts/check-repo.mjs",
    "check:secrets": "node scripts/check-secrets.mjs --history",
    "test": "vitest run",
    "test:e2e": "playwright test --project=e2e",
    "test:ui": "playwright test --project=ui",
    "verify": "npm run check:repo && npm run check:ascii && npm run check:ui && npm run lint && npm run typecheck && npm run test",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.11",
    "@mui/material": "7.3.11",
    "@mui/material-nextjs": "7.3.10",
    "@prisma/client": "6.19.3",
    "@tanstack/react-query": "5.107.1",
    "next": "15.5.29",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "prettier": "3.9.10",
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
