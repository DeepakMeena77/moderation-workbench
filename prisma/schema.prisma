// Data model: docs/02-system-design.md sec. 3. Models arrive slice by slice (S1 onwards).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  author
  moderator
  senior_moderator
  admin
}

// The role is read from this row on every request (SEC-1); it is never stored in the session token.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         Role
  passwordHash String
  createdAt    DateTime @default(now())

  content   Content[]
  reports   Report[]
  decisions Decision[]
}

// Fixed-window counters for database-backed rate limits (SEC-4), so limits hold across serverless instances.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
}

// --- S2: policy, content, reports, cases, analyses, jobs, audit (docs/02-system-design.md sec. 3) ---

enum ContentType {
  post
  comment
}

enum Visibility {
  visible
  labeled
  limited
  removed
}

enum Severity {
  low
  medium
  high
}

enum CaseStatus {
  pending_analysis
  auto_cleared
  awaiting_review
  resolved
  appealed
  appeal_resolved
}

enum CaseTrigger {
  new_content
  report
  reopen
}

enum PolicyStatus {
  active
  retired
}

enum JobType {
  analyze
  appeal_brief
}

enum JobStatus {
  queued
  running
  succeeded
  failed
}

enum AiStatus {
  ok
  timeout
  rate_limited
  invalid_output
  invalid_input
  provider_error
  budget_exhausted
  unavailable
}

enum ActorType {
  human
  system
  ai
}

// Published versions are immutable. Exactly one row is active: a partial unique index in the migration
// enforces it in the database (POL-1).
model Policy {
  id            String       @id @default(cuid())
  version       Int          @unique
  status        PolicyStatus
  clauses       Json
  notes         String?
  contentHash   String       @unique
  publishedById String?
  publishedAt   DateTime     @default(now())
}

// The text is immutable after creation. Only services/visibility.ts may change `visibility` (HUM-1); a database
// trigger refuses the change unless that function set app.actor_type = 'human' in the transaction.
model Content {
  id         String      @id @default(cuid())
  type       ContentType
  parentId   String?
  authorId   String
  body       String
  visibility Visibility  @default(visible)
  createdAt  DateTime    @default(now())

  author   User      @relation(fields: [authorId], references: [id])
  parent   Content?  @relation("Thread", fields: [parentId], references: [id])
  comments Content[] @relation("Thread")
  reports  Report[]
  case     Case?

  @@index([type, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
}

model Report {
  id         String   @id @default(cuid())
  contentId  String
  reporterId String
  reason     String
  note       String?
  createdAt  DateTime @default(now())

  content  Content @relation(fields: [contentId], references: [id])
  reporter User    @relation(fields: [reporterId], references: [id])

  // CNT-3: one report per user per item; a second one is a 409.
  @@unique([contentId, reporterId])
}

model Case {
  id                String      @id @default(cuid())
  contentId         String      @unique
  status            CaseStatus
  trigger           CaseTrigger
  priority          Int         @default(0)
  currentAnalysisId String?     @unique
  reportCount       Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  content         Content    @relation(fields: [contentId], references: [id])
  analyses        Analysis[]
  // The analysis a decision must be made on (HUM-6). One analysis is current for at most one case.
  currentAnalysis Analysis?  @relation("CurrentAnalysis", fields: [currentAnalysisId], references: [id])
  decisions       Decision[]

  @@index([status, priority(sort: Desc), createdAt])
}

// Insert-only and versioned: re-analysis adds seq + 1 and never overwrites (POL-3). A database trigger rejects
// UPDATE and DELETE (AUD-2).
model Analysis {
  id             String   @id @default(cuid())
  caseId         String
  seq            Int
  policyVersion  Int
  // initial | report | reanalyze | policy_change
  reason         String
  ruleFindings   Json
  aiFindings     Json?
  recommendation Json
  aiStatus       AiStatus
  aiRunId        String?
  createdAt      DateTime @default(now())

  case       Case       @relation(fields: [caseId], references: [id])
  currentFor Case?      @relation("CurrentAnalysis")
  decisions  Decision[]
  aiRun      AiRun?     @relation(fields: [aiRunId], references: [id])

  @@unique([caseId, seq])
}

// One row per AI pipeline run (AI-10): tokens and cost summed over every attempt, repair and fallback. Rows that
// made no call (invalid_input, budget_exhausted) are kept with 0 tokens. Insert-only (AUD-2). The daily budget
// (AI_MAX_CALLS_PER_DAY) sums `attempts` over today's rows.
model AiRun {
  id             String   @id @default(cuid())
  purpose        String
  provider       String
  model          String
  modelsTried    String[]
  promptVersion  String
  promptHash     String
  policyVersion  Int?
  inputTokens    Int
  outputTokens   Int
  thinkingTokens Int
  costUsd        Decimal  @db.Decimal(10, 6)
  latencyMs      Int
  attempts       Int
  repairUsed     Boolean
  fallbackUsed   Boolean
  parseStrategy  String?
  trimmedContext Boolean
  status         AiStatus
  errorCode      String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  analyses Analysis[]

  @@index([createdAt])
}

// Database-backed queue (OPS-4, docs/02-system-design.md sec. 6). dedupeKey makes enqueueing idempotent.
model Job {
  id          String    @id @default(cuid())
  type        JobType
  payload     Json
  dedupeKey   String    @unique
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now())
  lockedUntil DateTime?
  lastError   String?
  runId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([runId, status])
}

// One row per policy publish (POL-3, docs/02-system-design.md sec. 6). Each analyse job enqueued for the run
// carries its id in Job.runId and adds 1 to `done` or `failed` in the transaction that completes or fails it.
model ReevaluationRun {
  id          String    @id @default(cuid())
  fromVersion Int
  toVersion   Int
  total       Int
  done        Int       @default(0)
  failed      Int       @default(0)
  startedById String
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([toVersion])
}

// Written in the same transaction as the change it records (AUD-1). The hash chain (prevHash, hash) and the
// insert-only trigger arrive in S7.
model AuditEvent {
  id            BigInt    @id @default(autoincrement())
  at            DateTime  @default(now())
  actorId       String?
  actorType     ActorType
  action        String
  entityType    String
  entityId      String
  before        Json?
  after         Json?
  policyVersion Int?
  requestId     String?

  @@index([entityType, entityId])
  @@index([at])
}

// --- S4: human decisions (docs/02-system-design.md sec. 3 and sec. 8) ---

// Ordered by strength: none < label < limit < remove.
enum ModAction {
  none
  label
  limit
  remove
}

enum DecisionKind {
  approve
  reject
  modify
}

enum ReasonCategory {
  false_positive
  missing_context
  wrong_clause
  severity_too_high
  severity_too_low
  policy_gap
  other
}

// Insert-only (AUD-2: a trigger rejects UPDATE and DELETE). It keeps the AI suggestion (recommendedAction) and
// the human outcome (finalAction) side by side, with the analysis and policy version they were based on (HUM-5).
model Decision {
  id                String          @id @default(cuid())
  caseId            String
  analysisId        String
  policyVersion     Int
  deciderId         String
  kind              DecisionKind
  recommendedAction ModAction
  finalAction       ModAction
  clauseCodes       String[]
  reasonCategory    ReasonCategory?
  rationale         String?
  createdAt         DateTime        @default(now())

  case     Case     @relation(fields: [caseId], references: [id])
  analysis Analysis @relation(fields: [analysisId], references: [id])
  decider  User     @relation(fields: [deciderId], references: [id])

  @@index([caseId, createdAt])
}
